{
  "expo": {
    "name": "FoodLeap",
    "slug": "foodleap",
    "scheme": "foodleap",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFBF5"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.foodleap.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFBF5"
      },
      "package": "com.foodleap.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#ff6b00"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "https://foodleap-api.victorlima124tt.workers.dev",
      "searchUrl": "https://foodleap-search.victorlima124tt.workers.dev",
      "eas": {
        "projectId": "foodleap-mobile-placeholder"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/foodleap-mobile-placeholder"
    },
    "runtimeVersion": "1.0.0"
  }
}
