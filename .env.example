# PostgreSQL (principal) - dentro do Docker use host 'postgres', fora use localhost
DATABASE_URL=postgresql://foodleap:foodleap_dev@localhost:5432/foodleap
POSTGRES_DB=foodleap
POSTGRES_USER=foodleap
POSTGRES_PASSWORD=foodleap_dev

# Redis (cache + sessão + rate-limit + filas)
# prefixos: cache_used:* (app) e cache_adm:* (admin) - TTLs: daily 24h, diet:plan 1h, search 5-15min
REDIS_URL=redis://localhost:6379/0
REDIS_ADM_URL=redis://localhost:6379/1

# Auth - gere com: openssl rand -hex 32
JWT_SECRET=change-me-super-secret-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
ADMIN_JWT_SECRET=change-me-admin-secret-min-32-chars

# Services (dev: localhost, prod: nomes do compose)
WEB_URL=http://localhost:3000
API_MAIN_URL=http://localhost:3001
SEARCH_SERVICE_URL=http://localhost:3002
ADMIN_API_URL=http://localhost:8000

# Observabilidade (opcional)
SENTRY_DSN=
